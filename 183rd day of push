a = [10, 20, 30, 40, 50]

n = int(input("Enter number to search: "))

low = 0
high = len(a) - 1

while low <= high:
    mid = (low + high) // 2

    if a[mid] == n:
        print("Element found at position:", mid + 1)
        break
    elif a[mid] < n:
        low = mid + 1
    else:
        high = mid - 1
else:
    print("Element not found")
