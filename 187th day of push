a = []

n = int(input("Enter number of elements: "))

for i in range(n):
    x = int(input("Enter element: "))
    a.append(x)

key = int(input("Enter element to search: "))

found = False

for i in range(n):
    if a[i] == key:
        print("Element found at position:", i + 1)
        found = True
        break

if found == False:
    print("Element not found")
