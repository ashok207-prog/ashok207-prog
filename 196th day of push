n = int(input("Enter number of elements: "))

a = []

for i in range(n):
    x = int(input("Enter element: "))
    a.append(x)

largest = a[0]
smallest = a[0]

for i in a:
    if i > largest:
        largest = i

    if i < smallest:
        smallest = i

print("Largest element:", largest)
print("Smallest element:", smallest)
